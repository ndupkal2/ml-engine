{
  "version": 2,
  "rewrites": [
    {
      "source": "/run-worker",
      "destination": "api/worker.py"
    },
    {
      "source": "/(.*)",
      "destination": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/run-worker",
      "schedule": "*/1 * * * *"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.14"
    },
    "api/worker.py": {
      "runtime": "python3.14"
    }
  },
  "env": {
    "REDIS_URL": "",
    "DATABASE_URL": ""
  },
  "installCommand": "apt-get update && apt-get install -y tesseract-ocr && pip install -r requirements.txt"
}
